  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-html5-camera-photo": "^1.5.5",
    "@types/string-similarity": "^4.0.2",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "$sharp"
