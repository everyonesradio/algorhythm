{
  "name": "algorhythm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_ENV=test vitest",
    "prettier": "npx prettier --write ./",
    "prebuild": "prisma generate && prisma db push",
    "type-check": "tsc --noEmit",
    "vinyl:seed": "tsx scripts/seed-covers.ts",
    "vinyl:index": "tsx scripts/create-vector-index.ts",
    "vinyl:eval": "tsx scripts/eval-recognition.ts",
    "vinyl:synth": "tsx scripts/make-synthetic-eval.ts",
    "vinyl:seed:local": "bash scripts/seed-local.sh",
    "vinyl:worker": "tsx scripts/ingest-worker.ts",
    "vinyl:remove": "tsx scripts/remove-album.ts",
    "vinyl:status": "tsx scripts/vinyl-status.ts",
    "vinyl:links": "tsx scripts/prefetch-links.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@prisma/client": "^6.19.3",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.22.1",
    "@trpc/next": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "lucide-react": "^1.66.0",
    "mobile-detect": "^1.4.5",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-camera-pro": "^1.4.0",
    "react-dom": "^19.3.1",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.7.0",
    "react-type-animation": "^3.2.0",
    "sharp": "^0.35.5",
    "string-similarity": "^4.0.4",
    "superjson": "^2.2.6",
    "three": "^0.187.0",
    "zod": "^4.6.7"
