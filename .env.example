# Database (MongoDB Atlas, needed for $vectorSearch)
DATABASE_URL=

# Vinyl recognition
# "atlas" (default) uses Atlas Vector Search; "local" brute-forces in Node
# (dev only, a few thousand covers max).
VECTOR_SEARCH_MODE=atlas
# MusicBrainz asks for an identifying User-Agent with contact info.
MUSICBRAINZ_USER_AGENT="algoRhythm/0.1 ( you@example.com )"

# Spotify
# Server-only credentials used by the cover seeder (preferred).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Legacy names still read by the link adapters. NOTE: the NEXT_PUBLIC_ prefix
# exposes the secret to the browser; migrate to the names above and rotate.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_CLIENT_SECRET=
SPOTIFY_AUTH_URL=
SPOTIFY_API_URL="https://api.spotify.com/v1/search"
SPOTIFY_CLIENT_VERSION=

# YouTube
YOUTUBE_MUSIC_URL="https://music.youtube.com/search"
YOUTUBE_COOKIES=

# Other Music Services
APPLE_MUSIC_API_URL="https://music.apple.com/us"
SOUNDCLOUD_BASE_URL="https://soundcloud.com"
TIDAL_BASE_URL="https://listen.tidal.com"
DEEZER_API_URL="https://api.deezer.com/search"

# Application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# URL Shortener
URL_SHORTENER_API_URL="http://localhost:4000/api/links"
URL_SHORTENER_API_KEY=