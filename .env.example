# Database (MongoDB Atlas, needed for $vectorSearch)
DATABASE_URL=

# MongoDB Atlas
VECTOR_SEARCH_MODE=atlas

# MusicBrainz
MUSICBRAINZ_USER_AGENT="algoRhythm/0.1 ( you@example.com )"

# Discogs
DISCOGS_TOKEN=

# Spotify (optional; official Web API, client credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
