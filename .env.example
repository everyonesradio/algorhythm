# Database (MongoDB Atlas, needed for $vectorSearch)
DATABASE_URL=

# MongoDB Atlas
VECTOR_SEARCH_MODE=atlas

# MusicBrainz
MUSICBRAINZ_USER_AGENT="algoRhythm/0.1 ( you@example.com )"

# Discogs
DISCOGS_TOKEN=

# Spotify (optional; official Web API, client credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SendGrid (waitlist welcome email; see docs/WAITLIST_EMAIL_COMPLIANCE.md)
# A restricted key with Mail Send only, a verified sender on the
# authenticated domain, the dynamic template made from
# emails/waitlist-welcome.html, and (recommended) an unsubscribe group id.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_WAITLIST_TEMPLATE_ID=
SENDGRID_UNSUBSCRIBE_GROUP_ID=
