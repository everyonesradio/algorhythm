// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Waitlist {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  timestamp DateTime?
}

// ---------------------------------------------------------------------------
// Vinyl recognition (image retrieval)
//
// Album           one row per release group (the "record"), carries metadata
// CoverEmbedding  N vectors per album: catalog art, Spotify art, augmented
//                 copies and confirmed real-world scans. Searched with Atlas
//                 Vector Search (index: cover_vector_index, see
//                 scripts/create-vector-index.ts)
// ScanEvent       every identify call; confirmed scans feed new embeddings
// ---------------------------------------------------------------------------

model Album {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  // Stable dedupe key: "mb:<release-group-mbid>" or "spotify:<album-id>"
  sourceKey     String           @unique
  mbid          String?          // MusicBrainz release-group id
  title         String
  artist        String
  artistMbid    String?
  artistName    String?          // canonical primary artist ("Kendrick Lamar", not "K-Dot")
  releaseYear   Int?
  primaryType   String?          // Album, EP, Single...
  genres        String[]
  tags          String[]
  labels        String[]
  coverUrl      String
  spotifyId     String?
  spotifyUrl    String?
  platformLinks Json?            // cached cross-platform links (search service)
  extra         Json?            // room for credits, tracklist, notes...
  embeddings    CoverEmbedding[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([artist])
  @@index([spotifyId])
  @@index([mbid])
}

model CoverEmbedding {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  albumId   String   @db.ObjectId
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  model     String   // EmbeddingModelKey, e.g. "clip-vit-b32"
  vector    Float[]
  // catalog | spotify | augment | closeup | user_scan
  source    String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([albumId, model, source])
}

model ScanEvent {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime @default(now())
  model            String
  vector           Float[]
  // matched | ambiguous | none
  status           String
  topAlbumIds      String[] @db.ObjectId
  topScores        Float[]
  // Artists offered when no album was certain ("Is it by one of these?").
  artistSuggestionMbids String[]
  confirmedAlbumId String?  @db.ObjectId
  confirmedAt      DateTime?

  @@index([createdAt])
}

// Background catalog ingest. One row per artist: a scan that matches or
// picks an album requests that artist's whole discography be vectorised.
// (kind, key) is unique, so repeat scans of the same artist are a no-op
// until the job is due for a refresh.
model IngestJob {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  kind       String    // "artist"
  key        String    // MusicBrainz artist id
  label      String    // human-readable, e.g. "Kendrick Lamar"
  // pending | running | done | failed
  status     String
  attempts   Int       @default(0)
  // what requested it: scan_match | scan_confirm | scan_pick | cli
  trigger    String?
  stats      Json?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([kind, key])
  @@index([status, updatedAt])
}
