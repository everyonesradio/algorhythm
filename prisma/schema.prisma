// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Waitlist {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  timestamp DateTime?
}

// ---------------------------------------------------------------------------
// Vinyl recognition (image retrieval)
//
// Album           one row per release group (the "record"), carries metadata
// CoverEmbedding  N vectors per album: catalog art, Spotify art, augmented
//                 copies and confirmed real-world scans. Searched with Atlas
//                 Vector Search (index: cover_vector_index, see
//                 scripts/create-vector-index.ts)
// ScanEvent       every identify call; confirmed scans feed new embeddings
// ---------------------------------------------------------------------------

model Album {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  // Stable dedupe key: "mb:<release-group-mbid>" or "spotify:<album-id>"
  sourceKey        String           @unique
  mbid             String? // MusicBrainz release-group id
  title            String
  artist           String
  artistMbid       String?
  artistName       String? // canonical primary artist ("Kendrick Lamar", not "K-Dot")
  releaseYear      Int?
  primaryType      String? // Album, EP, Single...
  genres           String[]
  tags             String[]
  styles           String[] // Discogs styles, e.g. "Boom Bap", "Jazzy Hip-Hop"
  labels           String[]
  coverUrl         String
  spotifyId        String?
  spotifyUrl       String?
  discogsMasterId  Int?
  discogsReleaseId Int?
  discogsArtistId  Int?
  // Last time we looked this album up on Discogs (found or not); pressings
  // are fetched at most once per 30 days per album.
  discogsCheckedAt DateTime?
  // Pressed on vinyl? "yes" | "no" | "unknown" (see catalog/vinyl-status.ts).
  // Only "yes" albums get vectors from catalog ingest.
  vinylStatus      String?
  vinylReleases    Int? // official vinyl releases found
  vinylSource      String? // "musicbrainz" | "discogs"
  vinylCheckedAt   DateTime?
  platformLinks    Json? // cached cross-platform links (search service)
  extra            Json? // room for credits, tracklist, notes...
  embeddings       CoverEmbedding[]
  libraryEntries   LibraryEntry[]
  libraryCount     Int? // visible finds in the public library
  libraryLastAt    DateTime? // latest visible find, for the Recent sort
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([artist])
  @@index([spotifyId])
  @@index([mbid])
  @@index([vinylStatus])
  @@index([libraryLastAt])
  @@index([libraryCount])
}

model CoverEmbedding {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  albumId          String   @db.ObjectId
  album            Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  model            String // EmbeddingModelKey, e.g. "clip-vit-b32"
  vector           Float[]
  // catalog | spotify | augment | closeup | variant | user_scan
  source           String
  imageUrl         String?
  // For "variant" vectors: the Discogs pressing this cover photo came from,
  // so a match can say which pressing the user is holding.
  discogsReleaseId Int?
  createdAt        DateTime @default(now())

  @@index([albumId, model, source])
}

model ScanEvent {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt             DateTime  @default(now())
  model                 String
  vector                Float[]
  // matched | ambiguous | none
  status                String
  topAlbumIds           String[]  @db.ObjectId
  topScores             Float[]
  // Artists offered when no album was certain ("Is it by one of these?").
  artistSuggestionMbids String[]
  confirmedAlbumId      String?   @db.ObjectId
  confirmedAt           DateTime?

  @@index([createdAt])
}

// Background catalog ingest. One row per artist: a scan that matches or
// picks an album requests that artist's whole discography be vectorised.
// (kind, key) is unique, so repeat scans of the same artist are a no-op
// until the job is due for a refresh.
model IngestJob {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  kind       String // "artist"
  key        String // MusicBrainz artist id
  label      String // human-readable, e.g. "Kendrick Lamar"
  // pending | running | done | failed
  status     String
  attempts   Int       @default(0)
  // what requested it: scan_match | scan_confirm | scan_pick | cli
  trigger    String?
  stats      Json?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([kind, key])
  @@index([status, updatedAt])
}

// Resolved streaming links, keyed by every platform URL of the album
// (Spotify, Apple Music, Deezer, Tidal...). Pasting any of them is one
// indexed read instead of MusicBrainz + platform API calls
// (services/links/). Refreshed in the background after 30 days.
model LinkIndex {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String   @unique // canonical album URL on one platform
  mbid      String? // MusicBrainz release group, when known
  title     String?
  artist    String?
  imageUrl  String?
  links     Json // AlbumLink[], card order
  fetchedAt DateTime

  @@index([mbid])
}

// The public library: records diggers have actually found and scanned. One
// entry per scan, added from the result drawer (docs/PUBLIC_LIBRARY.md).
// Open and anonymous for now: no handles or profiles until the music
// education ("Letterboxd for music") phase.
model LibraryEntry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  albumId       String   @db.ObjectId
  album         Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  scanId        String   @unique @db.ObjectId // one find per scan
  coverUrl      String? // the art that matched (pressing / Spotify)
  deviceKeyHash String // lets the same device remove it
  note          String? // up to 140 characters
  event         String? // pop-up slug (see Event), when added at a pop-up
  // How the record was named: "app" (matched), "suggestions" (picked from
  // the app's candidates) or "hand" (entered by artist search: taught).
  namedBy       String?
  hidden        Boolean  @default(false) // moderation
  reporters     String[] // device-key hashes of people who reported it
  createdAt     DateTime @default(now())

  @@index([albumId, createdAt])
  @@index([createdAt])
  @@index([deviceKeyHash, createdAt])
  @@index([event, createdAt])
}

// A pop-up ("Stump the Algorithm" at a record shop). Phones that open its
// join link (QR at the venue) during the event credit their library finds
// to it; its page shows the scoreboard and every find. Created with
// `npm run vinyl:event`.
model Event {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  name         String
  venue        String?
  city         String?
  description  String?
  startsAt     DateTime
  endsAt       DateTime
  joinCodeHash String // only the hash of the code on the QR is stored
  createdAt    DateTime @default(now())

  @@index([startsAt])
}
